<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NY Jets Hub – Official Fan Source</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --jets-green: #125740;
    --jets-green-bright: #18a060;
    --jets-dark: #0a0a0a;
    --jets-navy: #0b1e2d;
    --jets-gold: #ffffff;
    --jets-light: #f0f0f0;
    --jets-mid: #1a1a1a;
    --jets-gray: #4a4a4a;
    --jets-border: #2a2a2a;
    --jets-accent: #1a7a50;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Barlow', sans-serif;
    background: #111;
    color: #eee;
    overflow-x: hidden;
  }

  /* ─── TOP BAR ─── */
  .topbar {
    background: var(--jets-dark);
    border-bottom: 1px solid var(--jets-border);
    padding: 6px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #aaa;
  }
  .topbar a { color: #aaa; text-decoration: none; margin-left: 14px; transition: color .2s; }
  .topbar a:hover { color: var(--jets-green-bright); }
  .topbar-left span { color: var(--jets-green-bright); font-weight: 600; }

  /* ─── HEADER / NAV ─── */
  header {
    background: var(--jets-dark);
    border-bottom: 3px solid var(--jets-green);
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    padding: 0 24px;
    gap: 24px;
  }
  .logo-block {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-shield {
    width: 52px;
    height: 60px;
    background: linear-gradient(135deg, var(--jets-green) 0%, #0a3d28 100%);
    clip-path: polygon(50% 0%, 100% 15%, 100% 70%, 50% 100%, 0% 70%, 0% 15%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(18,87,64,0.5);
  }
  .logo-shield img {
    width: 36px;
    height: auto;
    filter: brightness(0) invert(1);
  }
  .logo-text-block {}
  .logo-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px;
    letter-spacing: 3px;
    color: #fff;
    line-height: 1;
  }
  .logo-sub {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--jets-green-bright);
    text-transform: uppercase;
  }

  nav {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar { display: none; }
  nav button {
    color: #ccc;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 22px 13px;
    display: block;
    position: relative;
    transition: color .2s;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
  }
  nav button:hover { color: var(--jets-green-bright); }
  nav button::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: var(--jets-green-bright);
    transform: scaleX(0);
    transition: transform .2s;
  }
  nav button:hover::after { transform: scaleX(1); }
  nav button.active { color: white; }
  nav button.active::after { transform: scaleX(1); }

  /* ─── TICKER ─── */
  .ticker-wrap {
    background: var(--jets-green);
    overflow: hidden;
    padding: 8px 0;
    position: relative;
  }
  .ticker-label {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background: var(--jets-dark);
    color: var(--jets-green-bright);
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: 2px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    font-size: 13px;
    z-index: 2;
  }
  .ticker-track {
    display: flex;
    animation: ticker 40s linear infinite;
    padding-left: 130px;
  }
  .ticker-item {
    white-space: nowrap;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: white;
    padding-right: 50px;
  }
  .ticker-dot { color: #a0ffcf; margin-right: 50px; }
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ─── HERO ─── */
  .hero {
    position: relative;
    height: 520px;
    overflow: hidden;
    background: linear-gradient(135deg, #060f0a 0%, #0a1f14 50%, #060f0a 100%);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 25% 50%, rgba(18,87,64,0.25) 0%, transparent 60%),
      radial-gradient(ellipse at 75% 30%, rgba(26,122,80,0.12) 0%, transparent 50%);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .hero-content {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 24px;
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 32px;
    height: 100%;
    align-items: center;
  }
  .hero-tag {
    display: inline-block;
    background: var(--jets-green);
    color: white;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 4px 10px;
    margin-bottom: 16px;
  }
  .hero-headline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 72px;
    line-height: 0.9;
    color: white;
    letter-spacing: 2px;
    margin-bottom: 20px;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }
  .hero-headline span { color: var(--jets-green-bright); }
  .hero-sub {
    font-size: 16px;
    color: #aaa;
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 28px;
  }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-photo-strip {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 380px;
  }
  .hero-photo-strip .photo-main {
    flex: 1;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }
  .hero-photo-strip .photo-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85) saturate(1.1);
    transition: transform .4s;
  }
  .hero-photo-strip .photo-main:hover img { transform: scale(1.04); }
  .hero-photo-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    height: 120px;
  }
  .hero-photo-row .photo-sm {
    overflow: hidden;
    border-radius: 2px;
  }
  .hero-photo-row .photo-sm img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8);
    transition: transform .4s;
  }
  .hero-photo-row .photo-sm:hover img { transform: scale(1.06); }

  /* ─── BUTTONS ─── */
  .btn-primary {
    background: var(--jets-green);
    color: white;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px 22px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background .2s;
  }
  .btn-primary:hover { background: var(--jets-accent); }
  .btn-outline {
    border: 1px solid #555;
    color: #ddd;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 9px 22px;
    background: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: border-color .2s, color .2s;
  }
  .btn-outline:hover { border-color: var(--jets-green-bright); color: var(--jets-green-bright); }

  /* ─── MAIN CONTENT ─── */
  .main-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 24px;
  }
  .section-hdr {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--jets-border);
    padding-bottom: 12px;
  }
  .section-hdr h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    color: white;
  }
  .section-hdr a {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: var(--jets-green-bright);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* ─── TAB CONTENT ─── */
  .tab-section { display: none; }
  .tab-section.active { display: block; }

  /* ─── NEWS GRID ─── */
  .news-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 24px;
  }
  .news-feature {
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
    overflow: hidden;
    position: relative;
  }
  .news-feature img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
    filter: brightness(0.9);
    transition: transform .4s;
  }
  .news-feature:hover img { transform: scale(1.03); }
  .news-feature-body {
    padding: 20px;
  }
  .news-tag {
    display: inline-block;
    background: var(--jets-green);
    color: white;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 3px 8px;
    margin-bottom: 10px;
  }
  .news-feature-body h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 22px;
    line-height: 1.2;
    color: white;
    margin-bottom: 10px;
  }
  .news-feature-body p { font-size: 14px; color: #999; line-height: 1.6; }
  .news-meta { font-size: 12px; color: #666; margin-top: 10px; }

  .news-sidebar {}
  .news-item {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--jets-border);
  }
  .news-item:last-child { border-bottom: none; }
  .news-item img {
    width: 90px;
    height: 68px;
    object-fit: cover;
    flex-shrink: 0;
    filter: brightness(0.85);
  }
  .news-item-body { flex: 1; }
  .news-item-body h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    color: #eee;
    margin-bottom: 4px;
  }
  .news-item-body p { font-size: 12px; color: #777; }

  /* ─── ROSTER TABLE ─── */
  .table-wrap {
    overflow-x: auto;
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
  }
  .roster-tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .roster-tbl thead tr {
    background: var(--jets-green);
  }
  .roster-tbl th {
    padding: 10px 12px;
    text-align: left;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: white;
    white-space: nowrap;
  }
  .roster-tbl td {
    padding: 9px 12px;
    border-bottom: 1px solid #1e1e1e;
    color: #ddd;
    white-space: nowrap;
  }
  .roster-tbl tr:hover td { background: rgba(18,87,64,0.12); }
  .roster-tbl tr:nth-child(even) td { background: rgba(255,255,255,0.02); }
  .pos-badge {
    display: inline-block;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 11px;
    padding: 2px 6px;
    background: var(--jets-border);
    color: #aaa;
    letter-spacing: 0.5px;
  }
  .pos-badge.qb { background: rgba(18,87,64,0.4); color: var(--jets-green-bright); }
  .pos-badge.rb { background: rgba(26,122,80,0.3); color: #6fd6a0; }
  .pos-badge.wr { background: rgba(30,100,60,0.3); color: #a0e0c0; }
  .pos-badge.te { background: rgba(10,60,40,0.5); color: #7dc0a0; }
  .pos-badge.ol { background: rgba(20,40,30,0.5); color: #809080; }
  .pos-badge.edge,.pos-badge.de { background: rgba(80,20,20,0.4); color: #d08080; }
  .pos-badge.dl,.pos-badge.dt { background: rgba(60,20,20,0.3); color: #c09090; }
  .pos-badge.lb { background: rgba(20,20,60,0.4); color: #9090d0; }
  .pos-badge.cb,.pos-badge.db { background: rgba(20,40,60,0.4); color: #80a0c0; }
  .pos-badge.s { background: rgba(10,30,50,0.5); color: #70b0d0; }

  /* ─── STATS ─── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .stat-card {
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
    overflow: hidden;
  }
  .stat-card-hdr {
    background: var(--jets-green);
    padding: 10px 16px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 2px;
    color: white;
  }
  .stat-row {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid #1e1e1e;
    gap: 12px;
  }
  .stat-row:last-child { border-bottom: none; }
  .stat-rank {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px;
    color: var(--jets-green-bright);
    width: 28px;
    flex-shrink: 0;
  }
  .stat-player { flex: 1; }
  .stat-player-name { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 15px; color: #eee; }
  .stat-player-sub { font-size: 11px; color: #666; }
  .stat-val { font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: white; text-align: right; }
  .stat-unit { font-family: 'Barlow Condensed', sans-serif; font-size: 10px; color: #666; text-transform: uppercase; text-align: right; }

  /* ─── DRAFT CARDS ─── */
  .draft-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }
  .draft-card {
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
    overflow: hidden;
    transition: border-color .2s, box-shadow .2s;
  }
  .draft-card:hover {
    border-color: var(--jets-green);
    box-shadow: 0 0 20px rgba(18,87,64,0.2);
  }
  .draft-card-hdr {
    background: linear-gradient(135deg, var(--jets-green) 0%, #0a3d28 100%);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .draft-pick-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    color: rgba(255,255,255,0.2);
    line-height: 1;
    flex-shrink: 0;
  }
  .draft-card-info h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 17px;
    color: white;
    line-height: 1.2;
  }
  .draft-card-info span {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .draft-card-body { padding: 16px 18px; }
  .pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .pros h4, .cons h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .pros h4 { color: var(--jets-green-bright); }
  .cons h4 { color: #d08080; }
  .pros ul, .cons ul {
    list-style: none;
    font-size: 12px;
    color: #999;
    line-height: 1.6;
  }
  .pros ul li::before { content: '+ '; color: var(--jets-green-bright); font-weight: 700; }
  .cons ul li::before { content: '− '; color: #d08080; font-weight: 700; }

  .overall-box {
    background: linear-gradient(135deg, var(--jets-green) 0%, #0a3d28 100%);
    padding: 24px 28px;
    margin-top: 8px;
  }
  .overall-box h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 24px;
    letter-spacing: 2px;
    color: white;
    margin-bottom: 10px;
  }
  .overall-box p { font-size: 14px; color: rgba(255,255,255,0.8); line-height: 1.7; }

  /* ─── ALL-TIME STATS ─── */
  .alltime-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
  }
  .alltime-card {
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
  }
  .alltime-hdr {
    background: var(--jets-green);
    padding: 10px 16px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 16px;
    letter-spacing: 2px;
    color: white;
  }
  .alltime-row {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid #1e1e1e;
    gap: 10px;
  }
  .alltime-row:last-child { border-bottom: none; }
  .alltime-rank { font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: var(--jets-green-bright); width: 24px; flex-shrink: 0; }
  .alltime-name { flex: 1; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 15px; color: #eee; }
  .alltime-val { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 13px; color: #aaa; }
  .alltime-label { font-size: 12px; color: #666; flex: 1; }

  .records-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
  }
  .record-item {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid #1a1a1a;
    font-size: 13px;
  }
  .record-item:last-child { border-bottom: none; }
  .record-label { color: #888; }
  .record-value { color: white; font-weight: 600; text-align: right; }

  /* ─── SCHEDULE ─── */
  .schedule-note {
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
    padding: 40px;
    text-align: center;
  }
  .schedule-note h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    color: white;
    margin-bottom: 12px;
  }
  .schedule-note p { color: #888; margin-bottom: 20px; }

  /* ─── PHOTOS / VIDEO ─── */
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  .media-card {
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
    overflow: hidden;
    transition: border-color .2s;
  }
  .media-card:hover { border-color: var(--jets-green); }
  .media-card a { text-decoration: none; color: inherit; }
  .media-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    filter: brightness(0.85);
    transition: transform .4s, filter .4s;
  }
  .media-card:hover img { transform: scale(1.04); filter: brightness(1); }
  .media-card-body { padding: 16px; }
  .media-card-body h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #eee;
    line-height: 1.3;
    margin-bottom: 6px;
  }
  .media-card-body p { font-size: 12px; color: #777; line-height: 1.5; margin-bottom: 10px; }
  .media-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: var(--jets-green-bright);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
  }

  .media-more {
    background: var(--jets-mid);
    border: 1px solid var(--jets-border);
    padding: 20px;
    margin-top: 20px;
  }
  .media-more h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 2px;
    color: white;
    margin-bottom: 12px;
  }
  .media-more ul { list-style: none; }
  .media-more ul li { border-bottom: 1px solid #1e1e1e; }
  .media-more ul li:last-child { border-bottom: none; }
  .media-more ul li a {
    display: block;
    padding: 10px 0;
    color: #aaa;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
